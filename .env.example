# imessage-intake — environment
# Copy to `.env.local` and fill in. Values are NOT committed.
# You already have every one of these from jonny-os / lexa — reuse them.

# ── Brain (Haiku for sift + schedule) ──────────────────────────────────────
ANTHROPIC_API_KEY=            # same key as jonny-os / lexa
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # cheap layer; leave as-is

# ── TickTick (the sink) ────────────────────────────────────────────────────
# EASIEST: copy all of these straight from jonny-os (same account + app, already
# authorized). ACCESS_TOKEN alone works until it expires (~Dec 2026); the client
# id/secret/refresh let it self-renew after that. Do NOT mix a jonny-os token with
# a different app's client id — a token only authenticates against its issuing app.
# EASIEST OF ALL — relay: post through jonny-os's already-authorized endpoint, no
# local TickTick auth at all. If this is set, it is used and the token vars below
# are ignored.
TICKTICK_RELAY_URL=          # e.g. https://jonny-os.vercel.app/api/ticktick/add
TICKTICK_ACCESS_TOKEN=        # copy from jonny-os; used directly if present
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REFRESH_TOKEN=       # fallback: refreshed into a new access token headlessly

# ── Approval loop — iMessage via BlueBubbles (the human gate) ───────────────
# Tasks are NOT auto-posted anymore: each one is texted to you as a proposal and
# only posts when you reply y / 👍 (edit to correct, n to drop). Transport is the
# free, self-hosted BlueBubbles server running on THIS Mac (uses the Apple ID
# already signed into Messages). See README for the ~5-min install.
BLUEBUBBLES_URL=http://localhost:1234   # BlueBubbles server address (default port 1234)
BLUEBUBBLES_PASSWORD=         # the server password you set in the BlueBubbles app
APPROVAL_ADDRESS=             # the handle the approval thread lives at — your own
                              # number (self-thread), e.g. +15551234567
# APPROVAL_SERVICE=iMessage   # optional; iMessage (default) or SMS
# BLUEBUBBLES_METHOD=private-api  # optional; private-api (default, reliable) or apple-script
# If BLUEBUBBLES_PASSWORD + APPROVAL_ADDRESS are unset, the loop can't send/read and
# the run just prints what it would propose (safe no-op).

# ── Email source — Notion "Communications Log" (already Claude-triaged) ─────
# Second intake source: your Make scenario already ingests + triages every email
# into this Notion DB. We just read the rows flagged as real tasks. Auth = ONE
# Notion internal-integration token (notion.so/my-integrations → share the DB with
# it). No Gmail OAuth, no Google console.
NOTION_TOKEN=                 # Notion internal integration secret (starts ntn_ / secret_)
# NOTION_COMMS_DB_ID=         # optional; defaults to the Communications Log DB id
# EMAIL_INTAKE_ENABLED=1      # set to 0 to turn the email source off

# ── Drive times (away events) ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=          # same key lexa uses (Google Routes API). Optional:
                              # unset = pipeline uses the static drive-time table.

# ── Trish relay (texts with Trish → jonny-os Communications Log) ────────────
# Used only by `npm run relay` — the second pipeline that ships the 1:1 thread with
# Trish (both directions) to the cloud, where the AI pass + Notion write happen.
# Independent of the task pipeline above (own watermark: state.trish.json).
JONNY_OS_INGEST_URL=          # e.g. https://jonny-os.vercel.app/api/imessage/ingest
CRON_SECRET=                  # same secret jonny-os uses to gate /api/*/ingest
TRISH_NUMBER=+19258040978     # the ONE thread the relay watches (both directions)
TRISH_STATE_PATH=             # optional; default ./state.trish.json

# ── Pipeline config ────────────────────────────────────────────────────────
CHAT_DB_PATH=                 # optional override; default ~/Library/Messages/chat.db
IGNORE_NUMBERS=+13212973385   # lexa's Linq line — never treat lexa's texts as tasks
MIN_MESSAGE_LENGTH=6          # skip trivially short messages
MAX_MESSAGES=200             # per-run cap: only the most recent N new messages (keeps
                             # the first run from chewing through your whole history)
STATE_PATH=                   # optional; default ./state.json (the ROWID watermark)
